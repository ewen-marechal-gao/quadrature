# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated at build time
/public/content-index*.json
/public/pagedjs/
/public/quadrature.pdf
# dérivés de assets/map.jpg (cf. scripts/generate-web-images.mjs) — seul
# l'original est versionné, et il reste hors de public/ pour ne pas partir
# dans l'export
/public/images/map-web.jpg
/public/og.jpg
