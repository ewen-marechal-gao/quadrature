# Clé API Mistral — requise pour le mode agent LLM (encounters avec agent: llm)
# Obtenez la vôtre sur https://console.mistral.ai/
MISTRAL_API_KEY=...

# Modèle Mistral utilisé pour les agents LLM (optionnel — défaut : mistral-small-latest)
# Modèles disponibles : mistral-small-latest, mistral-medium-latest, mistral-large-latest
# MISTRAL_MODEL=mistral-small-latest
